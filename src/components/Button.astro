---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {}

const { class: classList = '', ...attrs } = Astro.props;
---

<button
  class:list={[
    'bg-primary text-on-primary flex items-center gap-1 px-4 py-2',
    classList,
  ]}
  {...attrs}
>
  <slot />
</button>
