---
import type { Lang } from '../i18n/default-lang-options';

const currentLocale = Astro.currentLocale as Lang;

type Job = {
  title: string;
  company: string;
  date: string;
  description: string;
};

const jobs: Record<Lang, Job[]> = {
  en: [
    {
      title: 'Front-end Engineer',
      company: 'Bupunku',
      date: '2023 — Present',
      description:
        'I’ve delivered high-impact front-end solutions for real-time, performance-critical products, improving stability, scalability, and user experience. My work includes building custom visualization tools, modernizing Angular applications, optimizing UIs for constrained hardware, and strengthening team delivery through technical leadership, architecture decisions, and close cross-functional collaboration.',
    },
  ],
  es: [
    {
      title: 'Ingeniero Front-end',
      company: 'Bupunku',
      date: '2023 — Presente',
      description:
        'He entregado soluciones front-end de alto impacto para productos en tiempo real y críticos en rendimiento, mejorando la estabilidad, escalabilidad y experiencia del usuario. Mi trabajo incluye la construcción de herramientas de visualización personalizadas, la modernización de aplicaciones Angular, la optimización de interfaces de usuario para hardware limitado y el fortalecimiento de la entrega del equipo a través del liderazgo técnico, decisiones arquitectónicas y colaboración cercana entre funciones.',
    },
  ],
};
---

<section class="pt-header-fixed-adjust section" id="experience">
  <h2 class="section-heading">
    {currentLocale === 'es' ? 'Experiencia' : 'Experience'}
  </h2>
  <ul>
    {
      jobs[currentLocale].map((job) => (
        <li>
          <h3 class="mb-text-spacing">
            {job.title} · {job.company}
          </h3>
          <p class="mb-text-spacing">{job.date}</p>
          <p>{job.description}</p>
        </li>
      ))
    }
  </ul>
</section>
