---
import { Send } from '@lucide/astro';
import { Icon } from 'astro-icon/components';
import FormField from './FormField.astro';
import Input from './Input.astro';
import Label from './Label.astro';
import Textarea from './Textarea.astro';
import Button from './Button.tsx';
---

<section class="pt-header-fixed-adjust section h-dvh" id="contact">
  <h2 class="section-heading">Contact me.</h2>
  <p class="mb-4">
    I'm always eager to explore new opportunities and take on exciting projects.
    If you have a project in mind, or just want to say hi, feel free to send me
    a message.
  </p>
  <form name="contact" data-netlify="true" class="mb-4 flex flex-col gap-4">
    <FormField>
      <Label slot="label" required for="name">Your Name</Label>
      <Input
        slot="input"
        type="text"
        name="name"
        id="name"
        placeholder="Your Name"
        required
      />
    </FormField>
    <FormField>
      <Label slot="label" required for="email">Email</Label>
      <Input
        slot="input"
        type="email"
        name="email"
        id="email"
        placeholder="tim@magic.com"
        required
      />
    </FormField>
    <FormField>
      <Label slot="label" required for="message">Message</Label>
      <Textarea
        slot="textarea"
        rows="4"
        name="message"
        id="message"
        placeholder="Hello there, I would like to ask you about..."
        required
      />
    </FormField>
    <div class="flex justify-end">
      <Button type="submit">
        <Send />Send
      </Button>
    </div>
  </form>
  <article>
    <p class="mb-4">You can also reach me with...</p>
    <div class="flex gap-4">
      <a
        href="https://www.linkedin.com/in/edwar-martinez-vale/"
        target="_blank"
        class="flex items-center"
        ><Icon class="mr-1 h-[24px] w-auto" name="linkedin" /> LinkedIn</a
      >
    </div>
  </article>
</section>
