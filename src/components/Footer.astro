---
const currentLocale = Astro.currentLocale;
---

<footer class="section flex justify-between py-12">
  <section class="grid content-start">
    <p class="font-bold">
      {currentLocale === 'es' ? 'Enlaces Importantes' : 'Important Links'}
    </p>
    <a href="/">{currentLocale === 'es' ? 'Inicio' : 'Home'}</a>
  </section>
  <section class="grid content-start">
    <p class="font-bold">
      {currentLocale === 'es' ? 'Redes Sociales' : 'Social'}
    </p>
    <a href="https://www.linkedin.com/in/edwar-martinez-vale" target="_blank"
      >LinkedIn</a
    >
    <a href="https://github.com/edwarmv" target="_blank">GitHub</a>
    <a
      href="https://bitbucket.org/edwarmv1/workspace/projects/BIN"
      target="_blank">BitBucket</a
    >
  </section>
</footer>
