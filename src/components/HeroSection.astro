---
import ButtonLink from './ButtonLink';
---

<div class="gradient">
  <div class="noise frosted-backdrop">
    <section
      class="section pt-header-fixed-adjust flex h-dvh flex-col justify-center"
    >
      <article class="w-full max-w-2xl">
        <h1 class="font-headline text-step-8 mb-12 font-bold">
          I build to solve real problems for real people.
        </h1>
        <p class="mb-12">
          Let’s turn your idea into a reliable product — or help your
          organization save time and money by optimizing and automating
          processes with systems tailored to your needs.
        </p>
        <div class="flex justify-end gap-4">
          <ButtonLink href="/#experience" color="secondary"
            >View Experience</ButtonLink
          >
          <ButtonLink href="/#contact">Get in touch</ButtonLink>
        </div>
      </article>
    </section>
  </div>
</div>
